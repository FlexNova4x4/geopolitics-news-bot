# Required for Telegram posting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# At least one provider key is required. Gemini is tried first.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=qwen/qwen3.8-27b

# One geopolitics website RSS and one YouTube channel ID.
# YouTube RSS contains metadata (title/description/link); this project does not download videos or scrape transcripts.
WEBSITE_RSS_URLS=https://www.mea.gov.in/press-releases.htm?dtl/rss,https://thediplomat.com/regions/south-asia/feed/,https://thediplomat.com/category/asia-geopolitics/feed/,https://thediplomat.com/category/asia-defense/feed/,https://defence.economictimes.indiatimes.com/rss/topstories,https://defence.economictimes.indiatimes.com/rss/policy-partnerships,https://defence.economictimes.indiatimes.com/rss/military-systems,https://defence.economictimes.indiatimes.com/rss/research-security,https://www.livefistdefence.com/feed/,https://www.indiandefensenews.in/feeds/posts/default?alt=rss,https://api.thehawk.in/rss/international-relations/india-china
YOUTUBE_CHANNEL_ID=

# Cycle behaviour
CYCLE_MINUTES=30
SERVICE_MINUTES=350
MAX_ITEM_AGE_HOURS=36
NEWS_TIMEZONE=Asia/Kolkata
MAX_STATE_ITEMS=5000

# Set these only when running locally against a GitHub repo's state branch.
# In GitHub Actions, GITHUB_REPOSITORY and GITHUB_TOKEN are injected by the workflow.
# GITHUB_REPOSITORY=owner/repo
# GITHUB_TOKEN=
STATE_BRANCH=bot-state

AI_BATCH_SIZE=4
